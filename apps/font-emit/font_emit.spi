///- --package .
:# font_emit static =
    :< testing
:< rust_operators
:< font_outline
:< font_glyph
:< font_face

:! bez_path = `(rust::rust_type `($'BezPath') `($'kurbo::BezPath') "type BezPath = class end")
:! glyf_b = `(rust::rust_type `($'GlyfB') `($'write_fonts::tables::glyf::GlyfLocaBuilder') "type GlyfB = class end")
:! metric_v = `(rust::rust_type `($'MetricV') `($'Vec<write_fonts::tables::hmtx::LongMetric>') "type MetricV = class end")
:! cmap_v = `(rust::rust_type `($'CmapV') `($'Vec<(char, write_fonts::types::GlyphId)>') "type CmapV = class end")

:= path_new () : bez_path = !\($'"kurbo::BezPath::new()"')
:= path_moveto (p : bez_path) (x : f64) (y : f64) : bez_path = !\($'"{ let mut q = !p; q.move_to((!x, !y)); q }"')
:= path_lineto (p : bez_path) (x : f64) (y : f64) : bez_path = !\($'"{ let mut q = !p; q.line_to((!x, !y)); q }"')
:= path_quadto (p : bez_path) (cx : f64) (cy : f64) (x : f64) (y : f64) : bez_path =
    !\($'"{ let mut q = !p; q.quad_to((!cx, !cy), (!x, !y)); q }"')
:= path_close (p : bez_path) : bez_path = !\($'"{ let mut q = !p; q.close_path(); q }"')

:~ ^ thread_segs (p : bez_path) (segs : list quad_seg) : bez_path =
    ?= segs ?|
    | s :: rest =>
        ?= s ?|
        | QLine e => thread_segs (path_lineto p e::x e::y) rest
        | QQuad (c, e) => thread_segs (path_quadto p c::x c::y e::x e::y) rest
    | [] => p

:= thread_contour (p : bez_path) (c : contour_q) : bez_path =
    := st = c::start
    path_close (thread_segs (path_moveto p st::x st::y) c::segs)

:~ ^ thread_contours (p : bez_path) (cs : list contour_q) : bez_path =
    ?= cs ?|
    | c :: rest => thread_contours (thread_contour p c) rest
    | [] => p

:= emit_glyf (o : outline quadratic) : bez_path =
    ?= o ?|
    | OQuad cs => thread_contours (path_new ()) cs

:= gb_new () : glyf_b = !\($'"{ let mut b = write_fonts::tables::glyf::GlyfLocaBuilder::new(); let mut nd = kurbo::BezPath::new(); nd.move_to((80.0, 0.0)); nd.line_to((520.0, 0.0)); nd.line_to((520.0, 700.0)); nd.line_to((80.0, 700.0)); nd.close_path(); nd.move_to((160.0, 100.0)); nd.line_to((160.0, 600.0)); nd.line_to((440.0, 600.0)); nd.line_to((440.0, 100.0)); nd.close_path(); b.add_glyph(&write_fonts::tables::glyf::SimpleGlyph::from_bezpath(&nd).unwrap()).unwrap(); b }"')
:= gb_add (b : glyf_b) (p : bez_path) : glyf_b = !\($'"{ let mut g = !b; g.add_glyph(&write_fonts::tables::glyf::SimpleGlyph::from_bezpath(&!p).unwrap()).unwrap(); g }"')
:= mv_new () : metric_v = !\($'"{ let mut v: Vec<write_fonts::tables::hmtx::LongMetric> = Vec::new(); v.push(write_fonts::tables::hmtx::LongMetric::new(500, 0)); v }"')
:= mv_push (v : metric_v) (a : u16) : metric_v = !\($'"{ let mut m = !v; m.push(write_fonts::tables::hmtx::LongMetric::new(!a, 0)); m }"')
:= cv_new () : cmap_v = !\($'"{ let v: Vec<(char, write_fonts::types::GlyphId)> = Vec::new(); v }"')
:= cv_push (v : cmap_v) (cp : u32) (gid : u32) : cmap_v = !\($'"{ let mut m = !v; m.push((char::from_u32(!cp).unwrap(), write_fonts::types::GlyphId::new(!gid))); m }"')

:~ ^ build_glyphs (gb : glyf_b) (mv : metric_v) (cv : cmap_v) (gid : u32) (gs : list glyph_p) : glyf_b * metric_v * cmap_v * u32 =
    ?= gs ?|
    | g :: rest =>
        := bp = emit_glyf g::outline
        build_glyphs (gb_add gb bp) (mv_push mv g::advance) (cv_push cv g::codepoint gid) (gid + 1u32) rest
    | [] => (gb, mv, cv, gid)

:~ ^ append_glyphs (a : list glyph_p) (b : list glyph_p) : list glyph_p =
    ?= a ?|
    | h :: t => h :: append_glyphs t b
    | [] => b

:~ ^ hangul_entries (s : u32) (n : u32) : list glyph_p =
    ?= n ?|
    | 0u32 => []
    | _ => { codepoint = s; advance = 840u16; outline = syllable_outline s } :: hangul_entries (s + 1u32) (n - 1u32)

:= finish (gb : glyf_b) (mv : metric_v) (cv : cmap_v) (nglyphs : u32) : i32 =
    !\($'"{ use write_fonts::tables::{head::{Flags, Head, MacStyle}, hhea::Hhea, maxp::Maxp, post::Post, cmap::Cmap, hmtx::Hmtx, loca::LocaFormat}; use write_fonts::types::{FWord, Fixed, LongDateTime, UfWord}; use write_fonts::FontBuilder; use write_fonts::tables::os2::Os2; use write_fonts::tables::os2::SelectionFlags; use write_fonts::tables::name::Name; use write_fonts::tables::name::NameRecord; use write_fonts::types::NameId; use write_fonts::types::Tag; let (glyf, loca, loca_format) = (!gb).build(); let hmtx = Hmtx::new(!mv, Vec::new()); let cv_vec = !cv; let cmap = Cmap::from_mappings(cv_vec.clone()).unwrap(); let n = !nglyphs as u16; let upem: u16 = 1000; let ascent: i16 = 952; let descent: i16 = -241; let bbox_xmax: i16 = 575; let loc_fmt: i16 = match loca_format { LocaFormat::Short => 0, LocaFormat::Long => 1 }; let head = Head::new(Fixed::from_i32(1), 0, Flags::empty(), upem, LongDateTime::new(0), LongDateTime::new(0), 0, descent, bbox_xmax, ascent, MacStyle::empty(), 8, loc_fmt); let hhea = Hhea::new(FWord::new(ascent), FWord::new(descent), FWord::new(0), UfWord::new(575), FWord::new(0), FWord::new(0), FWord::new(bbox_xmax), 1, 0, 0, n); let maxp = { let mut mp = Maxp::new(n); mp.max_points = Some(512); mp.max_contours = Some(64); mp.max_composite_points = Some(0); mp.max_composite_contours = Some(0); mp.max_zones = Some(1); mp.max_twilight_points = Some(0); mp.max_storage = Some(0); mp.max_function_defs = Some(0); mp.max_instruction_defs = Some(0); mp.max_stack_elements = Some(0); mp.max_size_of_instructions = Some(0); mp.max_component_elements = Some(0); mp.max_component_depth = Some(0); mp }; let post = Post::new(Fixed::from_i32(0), FWord::new(-75), FWord::new(50), 0, 0, 0, 0, 0); let mut b = FontBuilder::new(); b.add_table(&head).unwrap(); b.add_table(&hhea).unwrap(); b.add_table(&maxp).unwrap(); b.add_table(&post).unwrap(); b.add_table(&hmtx).unwrap(); b.add_table(&cmap).unwrap(); b.add_table(&glyf).unwrap(); b.add_table(&loca).unwrap(); let mut os2 = Os2::default(); os2.us_weight_class = 400; os2.fs_type = 0; os2.fs_selection = SelectionFlags::from_bits_truncate(192); os2.s_typo_ascender = ascent; os2.s_typo_descender = descent; os2.s_typo_line_gap = 0; os2.us_win_ascent = ascent as u16; os2.us_win_descent = (-descent) as u16; os2.us_first_char_index = 32; os2.us_last_char_index = 126; os2.ach_vend_id = Tag::new(&[83u8, 97, 110, 115]); os2.ul_unicode_range_1 = 1; os2.ul_code_page_range_1 = Some(1); os2.ul_code_page_range_2 = Some(0); os2.sx_height = Some(500); os2.s_cap_height = Some(710); os2.us_default_char = Some(0); os2.us_break_char = Some(32); os2.us_max_context = Some(0); let name = Name::new([NameRecord::new(3, 1, 1033, NameId::new(1), String::from_utf8([83u8, 97, 110, 115].to_vec()).unwrap().into()), NameRecord::new(3, 1, 1033, NameId::new(2), String::from_utf8([82u8, 101, 103, 117, 108, 97, 114].to_vec()).unwrap().into()), NameRecord::new(3, 1, 1033, NameId::new(4), String::from_utf8([83u8, 97, 110, 115, 32, 82, 101, 103, 117, 108, 97, 114].to_vec()).unwrap().into()), NameRecord::new(3, 1, 1033, NameId::new(6), String::from_utf8([83u8, 97, 110, 115, 45, 82, 101, 103, 117, 108, 97, 114].to_vec()).unwrap().into())].to_vec()); b.add_table(&os2).unwrap(); b.add_table(&name).unwrap(); let bytes = { use write_fonts::tables::gsub::builders::{SingleSubBuilder, LigatureSubBuilder}; use write_fonts::tables::layout::builders::Builder; use write_fonts::tables::variations::ivs_builder::VariationStoreBuilder; use write_fonts::tables::gsub::{Gsub, SubstitutionLookup, SubstitutionLookupList}; use write_fonts::tables::layout::{Feature, FeatureList, FeatureRecord, LangSys, Lookup, LookupFlag, Script, ScriptList, ScriptRecord}; use write_fonts::types::GlyphId16; let fg = |cp: u32| -> u16 { cv_vec.iter().find(|(c, _)| *c as u32 == cp).map(|(_, g)| g.to_u32() as u16).unwrap_or(0) }; let mk = |ps: &[(u16, u16)]| { let mut sb = SingleSubBuilder::default(); for &(f, t) in ps { sb.insert(GlyphId16::new(f), GlyphId16::new(t)); } let mut vs = VariationStoreBuilder::new(0); Lookup::new(LookupFlag::empty(), sb.build(&mut vs)) }; let li: SubstitutionLookup = mk(&[(fg(0x0628), fg(0xFE91)), (fg(0x062A), fg(0xFE97)), (fg(0x062B), fg(0xFE9B)), (fg(0x0646), fg(0xFEE7)), (fg(0x064A), fg(0xFEF3)), (fg(0x0644), fg(0xFEDF)), (fg(0x0645), fg(0xFEE3)), (fg(0x062C), fg(0xFE9F)), (fg(0x062D), fg(0xFEA3)), (fg(0x062E), fg(0xFEA7)), (fg(0x0633), fg(0xFEB3)), (fg(0x0634), fg(0xFEB7)), (fg(0x0635), fg(0xFEBB)), (fg(0x0636), fg(0xFEBF)), (fg(0x0637), fg(0xFEC3)), (fg(0x0638), fg(0xFEC7)), (fg(0x0639), fg(0xFECB)), (fg(0x063A), fg(0xFECF)), (fg(0x0641), fg(0xFED3)), (fg(0x0642), fg(0xFED7)), (fg(0x0643), fg(0xFEDB)), (fg(0x0647), fg(0xFEEB))]).into(); let lm: SubstitutionLookup = mk(&[(fg(0x0628), fg(0xFE92)), (fg(0x062A), fg(0xFE98)), (fg(0x062B), fg(0xFE9C)), (fg(0x0646), fg(0xFEE8)), (fg(0x064A), fg(0xFEF4)), (fg(0x0644), fg(0xFEE0)), (fg(0x0645), fg(0xFEE4)), (fg(0x062C), fg(0xFEA0)), (fg(0x062D), fg(0xFEA4)), (fg(0x062E), fg(0xFEA8)), (fg(0x0633), fg(0xFEB4)), (fg(0x0634), fg(0xFEB8)), (fg(0x0635), fg(0xFEBC)), (fg(0x0636), fg(0xFEC0)), (fg(0x0637), fg(0xFEC4)), (fg(0x0638), fg(0xFEC8)), (fg(0x0639), fg(0xFECC)), (fg(0x063A), fg(0xFED0)), (fg(0x0641), fg(0xFED4)), (fg(0x0642), fg(0xFED8)), (fg(0x0643), fg(0xFEDC)), (fg(0x0647), fg(0xFEEC))]).into(); let lfn: SubstitutionLookup = mk(&[(fg(0x0628), fg(0xFE90)), (fg(0x062A), fg(0xFE96)), (fg(0x062B), fg(0xFE9A)), (fg(0x0646), fg(0xFEE6)), (fg(0x064A), fg(0xFEF2)), (fg(0x062F), fg(0xFEAA)), (fg(0x0630), fg(0xFEAC)), (fg(0x0631), fg(0xFEAE)), (fg(0x0632), fg(0xFEB0)), (fg(0x0644), fg(0xFEDE)), (fg(0x0645), fg(0xFEE2)), (fg(0x062C), fg(0xFE9E)), (fg(0x062D), fg(0xFEA2)), (fg(0x062E), fg(0xFEA6)), (fg(0x0633), fg(0xFEB2)), (fg(0x0634), fg(0xFEB6)), (fg(0x0635), fg(0xFEBA)), (fg(0x0636), fg(0xFEBE)), (fg(0x0637), fg(0xFEC2)), (fg(0x0638), fg(0xFEC6)), (fg(0x0639), fg(0xFECA)), (fg(0x063A), fg(0xFECE)), (fg(0x0641), fg(0xFED2)), (fg(0x0642), fg(0xFED6)), (fg(0x0643), fg(0xFEDA)), (fg(0x0647), fg(0xFEEA)), (fg(0x0648), fg(0xFEEE)), (fg(0x0629), fg(0xFE94)), (fg(0x0622), fg(0xFE82)), (fg(0x0623), fg(0xFE84)), (fg(0x0625), fg(0xFE88)), (fg(0x0649), fg(0xFEF0))]).into(); let lcj: SubstitutionLookup = { let mut lg = LigatureSubBuilder::default(); lg.insert([GlyphId16::new(fg(0x0915)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x0936))].to_vec(), GlyphId16::new(fg(0xE000))); lg.insert([GlyphId16::new(fg(0x0924)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x0930))].to_vec(), GlyphId16::new(fg(0xE001))); lg.insert([GlyphId16::new(fg(0x091C)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x091E))].to_vec(), GlyphId16::new(fg(0xE002))); lg.insert([GlyphId16::new(fg(0x0926)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x092F))].to_vec(), GlyphId16::new(fg(0xE003))); lg.insert([GlyphId16::new(fg(0x0936)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x0930))].to_vec(), GlyphId16::new(fg(0xE004))); lg.insert([GlyphId16::new(fg(0x0938)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x0924))].to_vec(), GlyphId16::new(fg(0xE005))); lg.insert([GlyphId16::new(fg(0x0928)), GlyphId16::new(fg(0x094D)), GlyphId16::new(fg(0x0924))].to_vec(), GlyphId16::new(fg(0xE006))); let mut vs2 = VariationStoreBuilder::new(0); Lookup::new(LookupFlag::empty(), lg.build(&mut vs2)).into() }; let lookups = SubstitutionLookupList::new([li, lm, lfn, lcj].to_vec()); let features = FeatureList::new([FeatureRecord::new(Tag::new(&[105u8, 110, 105, 116]), Feature::new(None, [0u16].to_vec())), FeatureRecord::new(Tag::new(&[109u8, 101, 100, 105]), Feature::new(None, [1u16].to_vec())), FeatureRecord::new(Tag::new(&[102u8, 105, 110, 97]), Feature::new(None, [2u16].to_vec())), FeatureRecord::new(Tag::new(&[99u8, 106, 99, 116]), Feature::new(None, [3u16].to_vec()))].to_vec()); let script = Script::new(Some(LangSys::new([0u16, 1, 2].to_vec())), Vec::new()); let dev2 = Script::new(Some(LangSys::new([3u16].to_vec())), Vec::new()); let scripts = ScriptList::new([ScriptRecord::new(Tag::new(&[97u8, 114, 97, 98]), script), ScriptRecord::new(Tag::new(&[100u8, 101, 118, 50]), dev2)].to_vec()); let gsub = Gsub::new(scripts, features, lookups); b.add_table(&gsub).unwrap(); { use write_fonts::tables::gpos::builders::{MarkToBaseBuilder, MarkToMarkBuilder, AnchorBuilder}; use write_fonts::tables::gpos::{Gpos, PositionLookup, PositionLookupList, MarkBasePos, MarkMarkPos}; let anu = fg(0x0902); let cb = fg(0x0901); if anu > 0 { let topb = [116u8, 111, 112]; let topc = std::str::from_utf8(&topb).unwrap(); let mut mb = MarkToBaseBuilder::default(); let _ = mb.insert_mark(GlyphId16::new(anu), topc, AnchorBuilder::new(48, 712)); if cb > 0 { let _ = mb.insert_mark(GlyphId16::new(cb), topc, AnchorBuilder::new(120, 712)); } for cp in [0x0915u32, 0x0916, 0x0917, 0x091A, 0x091C, 0x091E, 0x0924, 0x0926, 0x0928, 0x092A, 0x092C, 0x092E, 0x092F, 0x0930, 0x0932, 0x0935, 0x0936, 0x0938, 0x0939] { let bg = fg(cp); if bg > 0 { mb.insert_base(GlyphId16::new(bg), topc, AnchorBuilder::new(280, 712)); } } let em = fg(0x0947); if em > 0 { let _ = mb.insert_mark(GlyphId16::new(em), topc, AnchorBuilder::new(140, 712)); } let aim = fg(0x0948); if aim > 0 { let _ = mb.insert_mark(GlyphId16::new(aim), topc, AnchorBuilder::new(140, 712)); } let iim = fg(0x0940); if iim > 0 { mb.insert_base(GlyphId16::new(iim), topc, AnchorBuilder::new(240, 712)); } let aam = fg(0x093E); if aam > 0 { mb.insert_base(GlyphId16::new(aam), topc, AnchorBuilder::new(57, 712)); } let rm = fg(0x0943); if rm > 0 { let botb = [98u8, 111, 116]; let botc = std::str::from_utf8(&botb).unwrap(); let _ = mb.insert_mark(GlyphId16::new(rm), botc, AnchorBuilder::new(72, -20)); for (cp, sx) in [(0x0915u32, 280i16), (0x0916, 472), (0x0917, 300), (0x091A, 472), (0x091C, 472), (0x091E, 472), (0x0924, 472), (0x0926, 472), (0x0928, 472), (0x092A, 472), (0x092C, 472), (0x092E, 472), (0x092F, 472), (0x0930, 230), (0x0932, 472), (0x0935, 472), (0x0936, 472), (0x0938, 472), (0x0939, 472)] { let bg = fg(cp); if bg