Size::unscaled(), LocationRef::default()).advance_width(gid).unwrap_or(0.0) as i32; let mut rout = String::new(); { struct Flat { c: Vec<Vec<(f64, f64)>>, cur: (f64, f64) } impl Flat { fn pp(&mut self, p: (f64, f64)) { self.c.last_mut().unwrap().push(p); self.cur = p; } } impl OutlinePen for Flat { fn move_to(&mut self, x: f32, y: f32) { self.c.push(Vec::new()); self.cur = (x as f64, y as f64); self.c.last_mut().unwrap().push((x as f64, y as f64)); } fn line_to(&mut self, x: f32, y: f32) { self.pp((x as f64, y as f64)); } fn quad_to(&mut self, cx: f32, cy: f32, x: f32, y: f32) { let (x0, y0) = self.cur; let mut i = 1; while i <= 8 { let t = (i as f64) / 8.0; let u = 1.0 - t; self.pp((u*u*x0 + 2.0*u*t*(cx as f64) + t*t*(x as f64), u*u*y0 + 2.0*u*t*(cy as f64) + t*t*(y as f64))); i += 1; } } fn curve_to(&mut self, _: f32, _: f32, _: f32, _: f32, x: f32, y: f32) { self.pp((x as f64, y as f64)); } fn close(&mut self) {} } let og = font.outline_glyphs(); let mut gi = 0u16; while gi < n { let mut ff = Flat { c: Vec::new(), cur: (0.0, 0.0) }; if let Some(g) = og.get(skrifa::GlyphId::new(gi as u32)) { let _ = g.draw(DrawSettings::unhinted(Size::unscaled(), &[] as &[_]), &mut ff); } let mut hd = 0; while hd < 40 { rout.push(45u8 as char); hd += 1; } rout.push(10u8 as char); rout.push_str(&gi.to_string()); rout.push(10u8 as char); let mut rr = 0; while rr < 26 { let py = 860.0 - ((rr as f64) + 0.5) / 26.0 * 1040.0; let mut cc = 0; while cc < 40 { let px = ((cc as f64) + 0.5) / 40.0 * 620.0; let mut wn = 0i32; for ct in ff.c.iter() { let nn = ct.len(); let mut i = 0; while i < nn { let a = ct[i]; let b = ct[(i + 1) % nn]; let il = (b.0 - a.0) * (py - a.1) - (px - a.0) * (b.1 - a.1); if a.1 <= py { if b.1 > py && il > 0.0 { wn += 1; } } else if b.1 <= py && il < 0.0 { wn -= 1; } i += 1; } } rout.push(if wn.abs() > 0 { 35u8 as char } else { 46u8 as char }); cc += 1; } rout.push(10u8 as char); rr += 1; } gi += 1; } } std::fs::write(String::from_utf8([114u8, 101, 110, 100, 101, 114, 46, 116, 120, 116].to_vec()).unwrap(), rout.as_bytes()).unwrap(); if gid.to_u32() == 1 && adv == 565 { 42 } else { 13 } }"')

:~ is_lc_latin (cp : u32) : bool =
    (cp >= 97u32 && cp <= 122u32) || (cp >= 224u32 && cp <= 246u32) || (cp >= 248u32 && cp <= 255u32)

:~ raise_lc (g : glyph_p) : glyph_p =
    ? is_lc_latin g::codepoint
    ?> { codepoint = g::codepoint; advance = g::advance; outline = scale_outline_y 1.046f64 g::outline }
    |: g

:~ ^ map_raise_lc (gs : list glyph_p) : list glyph_p =
    ?= gs ?|
    | g :: rest => raise_lc g :: map_raise_lc rest
    | [] => []

:= main () =
    := glyphs : list glyph_p = [
