## main

<!-- livebook:{"chunks":null,"kind":"Elixir.Spiral.Kino.SmartCell","attrs":{"timeout":300,"source":"///> _\n\ninl main (args : array_base string) =\n    Info |> Some |> init_trace_state\n    trace Info\n        fun () => \"documents.main\"\n        fun () => { args }\n    inl command = get_command ()\n    inl arg_matches = command |> runtime.command_get_matches\n    inl source_dir =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .source_dir |> fst)\n        |> optionm'.unbox\n        |> optionm.value\n        |> sm'.from_std_string\n    inl dist_dir =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .dist_dir |> fst)\n        |> optionm'.unbox\n        |> optionm.value\n        |> sm'.from_std_string\n    inl cache_dir =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .cache_dir |> fst)\n        |> optionm'.unbox\n        |> optionm.value\n        |> sm'.from_std_string\n    inl hangul_spec =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .hangul_spec |> fst)\n        |> optionm'.unbox\n        |> optionm.map sm'.from_std_string\n        |> optionm'.default_value \"por-br\"\n    inl filter =\n        arg_matches\n        |> runtime.matches_get_one (get_args () .filter |> fst)\n        |> optionm'.unbox\n        |> optionm.map sm'.from_std_string\n    inl transcribe_only =\n        arg_matches\n        |> runtime.matches_get_flag (get_args () .transcribe_only |> fst)\n    inl result =\n        run { source_dir dist_dir cache_dir hangul_spec filter transcribe_only }\n        |> async.block_on_futures\n        |> resultm.unbox\n    match result with\n    | Ok result =>\n        trace Info\n            fun () => \"documents.main\"\n            fun () => { result_len = result |> am'.vec_len }\n        0i32\n    | Error error =>\n        trace Critical\n            fun () => \"documents.main\"\n            fun () => { error }\n        1i32\ninl main () =\n    // F# (the Fable path) gets `tests` and `main args`. The native Rust backend (`--backend Rust`, build.ps1's native\n    // section) runs `main` here: clap parses `std::env::args` itself (the args below only feed the `documents.main`\n    // trace) and a failure exits with its code. This `main` stays unit (a unit `main` exits with 0), since an i32 one\n    // would also change the F# output.\n    backend_switch {\n        Fsharp = fun () =>\n            $'let tests () = !tests ()' : ()\n            $'let main args = !main args' : ()\n        Rust = fun () =>\n            inl args =\n                $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'\n                : array_base string\n            inl exit_code = main args\n            $'if !exit_code \\!= 0 { std::process::exit(!exit_code) }' : ()\n    } : ()","print_code":false},"livebook_object":"smart_cell"} -->

```elixir
Spiral.Kino.eval!(
  ~S"""
  ///> _

  inl main (args : array_base string) =
      Info |> Some |> init_trace_state
      trace Info
          fun () => "documents.main"
          fun () => { args }
      inl command = get_command ()
      inl arg_matches = command |> runtime.command_get_matches
      inl source_dir =
          arg_matches
          |> runtime.matches_get_one (get_args () .source_dir |> fst)
          |> optionm'.unbox
          |> optionm.value
          |> sm'.from_std_string
      inl dist_dir =
          arg_matches
          |> runtime.matches_get_one (get_args () .dist_dir |> fst)
          |> optionm'.unbox
          |> optionm.value
          |> sm'.from_std_string
      inl cache_dir =
          arg_matches
          |> runtime.matches_get_one (get_args () .cache_dir |> fst)
          |> optionm'.unbox
          |> optionm.value
          |> sm'.from_std_string
      inl hangul_spec =
          arg_matches
          |> runtime.matches_get_one (get_args () .hangul_spec |> fst)
          |> optionm'.unbox
          |> optionm.map sm'.from_std_string
          |> optionm'.default_value "por-br"
      inl filter =
          arg_matches
          |> runtime.matches_get_one (get_args () .filter |> fst)
          |> optionm'.unbox
          |> optionm.map sm'.from_std_string
      inl transcribe_only =
          arg_matches
          |> runtime.matches_get_flag (get_args () .transcribe_only |> fst)
      inl result =
          run { source_dir dist_dir cache_dir hangul_spec filter transcribe_only }
          |> async.block_on_futures
          |> resultm.unbox
      match result with
      | Ok result =>
          trace Info
              fun () => "documents.main"
              fun () => { result_len = result |> am'.vec_len }
          0i32
      | Error error =>
          trace Critical
              fun () => "documents.main"
              fun () => { error }
          1i32
  inl main () =
      // F# (the Fable path) gets `tests` and `main args`. The native Rust backend (`--backend Rust`, build.ps1's native
      // section) runs `main` here: clap parses `std::env::args` itself (the args below only feed the `documents.main`
      // trace) and a failure exits with its code. This `main` stays unit (a unit `main` exits with 0), since an i32 one
      // would also change the F# output.
      backend_switch {
          Fsharp = fun () =>
              $'let tests () = !tests ()' : ()
              $'let main args = !main args' : ()
          Rust = fun () =>
              inl args =
                  $'Rc::new(RefCell::new(std::env::args().skip(1).map(|x| Rc::<str>::from(x)).collect::<Vec<Rc<str>>>()))'
                  : array_base string
              inl exit_code = main args
              $'if !exit_code \!= 0 { std::process::exit(!exit_code) }' : ()
      } : ()
  """,
  timeout: 300_000
)
```
