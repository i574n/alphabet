      poly4_contour 310.0f64 520.0f64 390.0f64 520.0f64 160.0f64 0.0f64 80.0f64 0.0f64;
      poly4_contour 310.0f64 520.0f64 390.0f64 520.0f64 620.0f64 0.0f64 540.0f64 0.0f64 ]

