:| dual_j = DualJ

:| right_j = RightJ

:== arabic_forms4 = { isol : outline quadratic; init : outline quadratic; medi : outline quadratic; fina : outline quadratic }

:== arabic_forms2 = { isol : outline quadratic; fina : outline quadratic }

:| arabic j =
    | Dual :: arabic_forms4 -> arabic dual_j
    | Right :: arabic_forms2 -> arabic right_j

:= ar_isolated \* j. (a : arabic j) : outline quadratic =
    ?= a ?|
    | Dual f => f::isol
    | Right f => f::isol

:= ar_final \* j. (a : arabic j) : outline quadratic =
    ?= a ?|
    | Dual f => f::fina
    | Right f => f::fina

:= ar_initial (a : arabic dual_j) : outline quadratic =
    ?= a ?|
    | Dual f => f::init

:= ar_medial (a : arabic dual_j) : outline quadratic =
    ?= a ?|
    | Dual f => f::medi

:~ ar_lconn () : contour_c = rect_contour 0.0f64 0.0f64 70.0f64 55.0f64

:~ ar_rconn () : contour_c = rect_contour 410.0f64 0.0f64 480.0f64 55.0f64

:~ beh_ar () : arabic dual_j =
    := base = [
        arch_down_contour 240.0f64 110.0f64 250.0f64 100.0f64 205.0f64 45.0f64;
        rect_contour 208.0f64 (-150.0f64) 272.0f64 (-80.0f64)
      ]
    Dual {
