:~ jamo_hieut () : list contour_c =
    [ ellipse_contour 350.0f64 170.0f64 160.0f64 160.0f64 !+;
      ellipse_contour 350.0f64 170.0f64 95.0f64 95.0f64 !-;
      rect_contour 110.0f64 410.0f64 600.0f64 490.0f64;
      rect_contour 300.0f64 540.0f64 410.0f64 650.0f64 ]

