:~ open_ring_lr (cx : f64) (cy : f64) (rxo : f64) (ryo : f64) (rxi : f64) (ryi : f64) : contour_c =
    := s = 0.70710678f64
    := sn = -0.70710678f64
    := tt = 0.55228475f64
    := tn = -0.55228475f64
    := t4 = 0.26521649f64
    := t4n = -0.26521649f64
    { start = pt (cx + rxo) cy;
        segs = [
        arc_seg cx cy rxo ryo 1.0f64 0.0f64 0.0f64 1.0f64 tt;
        arc_seg cx cy rxo ryo 0.0f64 1.0f64 (-1.0f64) 0.0f64 tt;
        arc_seg cx cy rxo ryo (-1.0f64) 0.0f64 0.0f64 (-1.0f64) tt;
        arc_seg cx cy rxo ryo 0.0f64 (-1.0f64) s sn t4;
        CLine (pt (cx + rxi * s) (cy - ryi * s));
        arc_seg cx cy rxi ryi s sn 0.0f64 (-1.0f64) t4n;
        arc_seg cx cy rxi ryi 0.0f64 (-1.0f64) (-1.0f64) 0.0f64 tn;
        arc_seg cx cy rxi ryi (-1.0f64) 0.0f64 0.0f64 1.0f64 tn;
        arc_seg cx cy rxi ryi 0.0f64 1.0f64 1.0f64 0.0f64 tn
      ] }

:~ open_ring_ul (cx : f64) (cy : f64) (rxo : f64) (ryo : f64) (rxi : f64) (ryi : f64) : contour_c =
    := s = 0.70710678f64
    := sn = -0.70710678f64
    := tt = 0.55228475f64
    := tn = -0.55228475f64
    := t4 = 0.26521649f64
    := t4n = -0.26521649f64
    { start = pt (cx - rxo) cy;
        segs = [
        arc_seg cx cy rxo ryo (-1.0f64) 0.0f64 0.0f64 (-1.0f64) tt;
        arc_seg cx cy rxo ryo 0.0f64 (-1.0f64) 1.0f64 0.0f64 tt;
        arc_seg cx cy rxo ryo 1.0f64 0.0f64 0.0f64 1.0f64 tt;
        arc_seg cx cy rxo ryo 0.0f64 1.0f64 sn s t4;
        CLine (pt (cx - rxi * s) (cy + ryi * s));
        arc_seg cx cy rxi ryi sn s 0.0f64 1.0f64 t4n;
        arc_seg cx cy rxi ryi 0.0f64 1.0f64 1.0f64 0.0f64 tn;
        arc_seg cx cy rxi ryi 1.0f64 0.0f64 0.0f64 (-1.0f64) tn;
        arc_seg cx cy rxi ryi 0.0f64 (-1.0f64) (-1.0f64) 0.0f64 tn
      ] }

