:~ jamo_bieup () : list contour_c =
    [ rect_contour 90.0f64 0.0f64 180.0f64 700.0f64;
      rect_contour 510.0f64 0.0f64 600.0f64 700.0f64;
      rect_contour 90.0f64 300.0f64 600.0f64 380.0f64;
      rect_contour 90.0f64 0.0f64 600.0f64 90.0f64 ]

:~ jamo_siot () : list contour_c =
    [ poly4_contour 310.0f64 700.0f64 390.0f64 700.0f64 160.0f64 0.0f64 80.0f64 0.0f64;
      poly4_contour 310.0f64 700.0f64 390.0f64 700.0f64 620.0f64 0.0f64 540.0f64 0.0f64 ]

:~ jamo_eo () : list contour_c =
