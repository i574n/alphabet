:~ arc_seg (cx : f64) (cy : f64) (rx : f64) (ry : f64) (ca : f64) (sa : f64) (cb : f64) (sb : f64) (tt : f64) : cubic_seg =
    CCubic (
        pt (cx + rx * (ca - tt * sa)) (cy + ry * (sa + tt * ca)),
        pt (cx + rx * (cb + tt * sb)) (cy + ry * (sb - tt * cb)),
        pt (cx + rx * cb) (cy + ry * sb)
    )

:~ arc_ring_c (cx : f64) (cy : f64) (rxo : f64) (ryo : f64) (rxi : f64) (ryi : f64) : contour_c =
    := s = 0.70710678f64
    := sn = -0.70710678f64
    := tt = 0.55228475f64
    := tn = -0.55228475f64
    { start = pt (cx + rxo * s) (cy + ryo * s);
        segs = [
        arc_seg cx cy rxo ryo s s sn s tt;
        arc_seg cx cy rxo ryo sn s sn sn tt;
        arc_seg cx cy rxo ryo sn sn s sn tt;
        CLine (pt (cx + rxi * s) (cy - ryi * s));
        arc_seg cx cy rxi ryi s sn sn sn tn;
        arc_seg cx cy rxi ryi sn sn sn s tn;
        arc_seg cx cy rxi ryi sn s s s tn
      ] }

:~ letter_c (advance : f64) : outline quadratic =
    := cx = advance / 2.0f64
    lower_to_quads (OCubic [ arc_ring_c cx 250.0f64 205.0f64 206.0f64 120.0f64 121.0f64 ])

