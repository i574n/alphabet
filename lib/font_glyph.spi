    := tt = 0.55228475f64
    := tn = -0.55228475f64
    lower_to_quads (OCubic [
        rect_contour 72.0f64 0.0f64 162.0f64 500.0f64;
        { start = pt 362.0f64 350.0f64;
            segs = [
