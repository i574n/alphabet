:~ jamo_ye () : list contour_c =
    [ rect_contour 330.0f64 0.0f64 420.0f64 700.0f64;
      rect_contour 420.0f64 220.0f64 540.0f64 300.0f64;
      rect_contour 420.0f64 420.0f64 540.0f64 500.0f64;
      rect_contour 560.0f64 0.0f64 650.0f64 700.0f64 ]

:= choseong (i : u32) : list contour_c =
    ?= i ?|
    | 0u32 => jamo_giyeok ()
    | 2u32 => jamo_nieun ()
    | 3u32 => jamo_digeut ()
    | 6u32 => jamo_mieum ()
    | 7u32 => jamo_bieup ()
    | 5u32 => jamo_rieul ()
    | 9u32 => jamo_siot ()
    | 11u32 => jamo_ieung ()
    | 12u32 => jamo_jieut ()
    | 14u32 => jamo_chieut ()
    | 15u32 => jamo_kieuk ()
    | 16u32 => jamo_tieut ()
    | 17u32 => jamo_pieup ()
    | 18u32 => jamo_hieut ()
    | 1u32 => jamo_ssanggiyeok ()
    | 4u32 => jamo_ssangdigeut ()
    | 8u32 => jamo_ssangbieup ()
    | 10u32 => jamo_ssangsiot ()
    | 13u32 => jamo_ssangjieut ()
    | _ => jamo_ieung ()

:= jungseong (j : u32) : list contour_c =
    ?= j ?|
    | 0u32 => jamo_a ()
    | 1u32 => jamo_ae ()
    | 2u32 => jamo_ya ()
    | 3u32 => jamo_yae ()
    | 4u32 => jamo_eo ()
    | 5u32 => jamo_e ()
    | 7u32 => jamo_ye ()
    | 6u32 => jamo_yeo ()
    | 8u32 => jamo_o ()
    | 12u32 => jamo_yo ()
    | 13u32 => jamo_u ()
    | 17u32 => jamo_yu ()
    | 18u32 => jamo_eu ()
    | 20u32 => jamo_i ()
    | _ => jamo_a ()

:= medial_horizontal (j : u32) : bool =
    ?= j ?|
    | 8u32 => true
    | 12u32 => true
    | 13u32 => true
    | 17u32 => true
    | 18u32 => true
    | _ => false

:= jongseong (k : u32) : list contour_c =
    ?= k ?|
    | 1u32 => jamo_giyeok ()
    | 4u32 => jamo_nieun ()
    | 7u32 => jamo_digeut ()
    | 8u32 => jamo_rieul ()
    | 16u32 => jamo_mieum ()
    | 17u32 => jamo_bieup ()
    | 19u32 => jamo_siot ()
    | 21u32 => jamo_ieung ()
    | 22u32 => jamo_jieut ()
    | 23u32 => jamo_chieut ()
    | 24u32 => jamo_kieuk ()
    | 25u32 => jamo_tieut ()
    | 26u32 => jamo_pieup ()
    | 27u32 => jamo_hieut ()
    | _ => jamo_ieung ()

:~ compose_vertical_final (initial : list contour_c) (medial : list contour_c) (final : list contour_c) : outline quadratic =
    lower_to_quads (OCubic (cc_append (cc_append (tf_contours 0.42f64 0.5f64 50.0f64 290.0f64 initial) (tf_contours 0.45f64 0.62f64 430.0f64 270.0f64 medial)) (tf_contours 0.82f64 0.36f64 80.0f64 10.0f64 final)))

:~ compose_horizontal_final (initial : list contour_c) (medial : list contour_c) (final : list contour_c) : outline quadratic =
    lower_to_quads (OCubic (cc_append (cc_append (tf_contours 0.5f64 0.3f64 175.0f64 490.0f64 initial) (tf_contours 0.92f64 0.34f64 30.0f64 250.0f64 medial)) (tf_contours 0.8f64 0.3f64 90.0f64 15.0f64 final)))

:= medial_compound (j : u32) : bool =
    ?= j ?|
    | 9u32 => true
    | 10u32 => true
    | 11u32 => true
    | 14u32 => true
    | 15u32 => true
    | 16u32 => true
    | 19u32 => true
    | _ => false

:= compound_h (j : u32) : list contour_c =
    ?= j ?|
    | 14u32 => jamo_u ()
    | 15u32 => jamo_u ()
    | 16u32 => jamo_u ()
    | 19u32 => jamo_eu ()
    | _ => jamo_o ()

:= compound_v (j : u32) : list contour_c =
    ?= j ?|
    | 10u32 => jamo_ae ()
    | 11u32 => jamo_i ()
    | 14u32 => jamo_eo ()
    | 15u32 => jamo_e ()
    | 16u32 => jamo_i ()
    | 19u32 => jamo_i ()
    | _ => jamo_a ()

:~ compose_compound (initial : list contour_c) (hv : list contour_c) (vv : list contour_c) : outline quadratic =
    lower_to_quads (OCubic (cc_append (cc_append (tf_contours 0.38f64 0.46f64 55.0f64 340.0f64 initial) (tf_contours 0.64f64 0.56f64 30.0f64 18.0f64 hv)) (tf_contours 0.42f64 0.92f64 440.0f64 30.0f64 vv)))

:~ compose_compound_final (initial : list contour_c) (hv : list contour_c) (vv : list contour_c) (final : list contour_c) : outline quadratic =
    lower_to_quads (OCubic (cc_append (cc_append (cc_append (tf_contours 0.34f64 0.4f64 55.0f64 470.0f64 initial) (tf_contours 0.56f64 0.44f64 30.0f64 250.0f64 hv)) (tf_contours 0.4f64 0.66f64 440.0f64 240.0f64 vv)) (tf_contours 0.82f64 0.3f64 80.0f64 15.0f64 final)))

:= syllable_outline (s : u32) : outline quadratic =
    := si = s - 44032u32
    := ini = si / 588u32
    := med = (si % 588u32) / 28u32
    := fin = si % 28u32
    ?= fin ?|
    | 0u32 => ? (medial_compound med) ?> compose_compound (choseong ini) (compound_h med) (compound_v med) |: (? (medial_horizontal med) ?> compose_horizontal (choseong ini) (jungseong med) |: compose_vertical (choseong ini) (jungseong med))
    | _ => ? (medial_compound med) ?> compose_compound_final (choseong ini) (compound_h med) (compound_v med) (jongseong fin) |: (? (medial_horizontal med) ?> compose_horizontal_final (choseong ini) (jungseong med) (jongseong fin) |: compose_vertical_final (choseong ini) (jungseong med) (jongseong fin))

:~ hangul_a_syllable (advance : f64) : outline quadratic =
    lower_to_quads (OCubic [
