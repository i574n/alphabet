      rect_contour 430.0f64 90.0f64 510.0f64 620.0f64 ]

:~ jamo_ssanggiyeok () : list contour_c =
    cc_append (tf_contours 0.46f64 1.0f64 0.0f64 0.0f64 (jamo_giyeok ())) (tf_contours 0.46f64 1.0f64 370.0f64 0.0f64 (jamo_giyeok ()))

:~ jamo_ssangdigeut () : list contour_c =
    cc_append (tf_contours 0.46f64 1.0f64 0.0f64 0.0f64 (jamo_digeut ())) (tf_contours 0.46f64 1.0f64 370.0f64 0.0f64 (jamo_digeut ()))

:~ jamo_ssangbieup () : list contour_c =
    cc_append (tf_contours 0.46f64 1.0f64 0.0f64 0.0f64 (jamo_bieup ())) (tf_contours 0.46f64 1.0f64 370.0f64 0.0f64 (jamo_bieup ()))

:~ jamo_ssangsiot () : list contour_c =
    cc_append (tf_contours 0.46f64 1.0f64 0.0f64 0.0f64 (jamo_siot ())) (tf_contours 0.46f64 1.0f64 370.0f64 0.0f64 (jamo_siot ()))

:~ jamo_ssangjieut () : list contour_c =
    cc_append (tf_contours 0.46f64 1.0f64 0.0f64 0.0f64 (jamo_jieut ())) (tf_contours 0.46f64 1.0f64 370.0f64 0.0f64 (jamo_jieut ()))

:~ jamo_e () : list contour_c =
