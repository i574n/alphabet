///> rust
:# devanagari_category_is_typed =
    := k = ka_deva ()
    := aa = matra_aa ()
    := iv = matra_i ()
    := aa_post = ?= matra_position aa ?| | MPost => true | _ => false
    := iv_pre = ?= matra_position iv ?| | MPre => true | _ => false
    (quad_seg_count (deva_base k) > 0u32, aa_post, iv_pre, quad_seg_count (deva_glyph iv) > quad_seg_count (deva_glyph aa))
    |> _assert_eq (true, true, true, true)

:== deva_cluster = { lead : deva cons_c; more : list (deva cons_c) }

:~ ^ cons_len (xs : list (deva cons_c)) : i32 =
    ?= xs ?|
    | _ :: t => 1i32 + cons_len t
    | [] => 0i32

:~ cluster_len (c : deva_cluster) : i32 = 1i32 + cons_len (c::more)

///> rust
:# devanagari_conjunct_is_typed =
    := ksha = { lead = ka_deva (); more = [ sa_deva () ] }
    := kta = { lead = ka_deva (); more = [ ta_deva (); sa_deva () ] }
    (cluster_len ksha, cluster_len kta)
    |> _assert_eq (2i32, 3i32)

:| deva_syllable =
    | Inherent :: deva_cluster -> deva_syllable
    | WithMatra :: { onset : deva_cluster; sign : deva matra_c } -> deva_syllable

:= syllable_onset_len (s : deva_syllable) : i32 =
    ?= s ?|
    | Inherent c => cluster_len c
    | WithMatra r => cluster_len (r::onset)

///> rust
:# devanagari_akshara_is_typed =
    := ki = WithMatra { onset = { lead = ka_deva (); more = [] }; sign = matra_i () }
    := kta = Inherent { lead = ka_deva (); more = [ ta_deva () ] }
    (syllable_onset_len ki, syllable_onset_len kta)
    |> _assert_eq (1i32, 2i32)

:~ ^ cons_glyphs (xs : list (deva cons_c)) : list (outline quadratic) =
    ?= xs ?|
    | h :: t => (deva_glyph h) :: cons_glyphs t
    | [] => []

:~ ^ outl_append (xs : list (outline quadratic)) (ys : list (outline quadratic)) : list (outline quadratic) =
    ?= xs ?|
    | h :: t => h :: outl_append t ys
    | [] => ys

:~ cluster_glyphs (c : deva_cluster) : list (outline quadratic) =
    (deva_glyph (c::lead)) :: cons_glyphs (c::more)

:= syllable_visual_order (s : deva_syllable) : list (outline quadratic) =
    ?= s ?|
    | Inherent c => cluster_glyphs c
    | WithMatra r =>
        := base_glyphs = cluster_glyphs (r::onset)
        := m = deva_glyph (r::sign)
        ?= matra_position (r::sign) ?|
        | MPre => m :: base_glyphs
        | _ => outl_append base_glyphs [ m ]

///> rust
:# devanagari_reorder_prebase_matra =
    := ki = WithMatra { onset = { lead = ka_deva (); more = [] }; sign = matra_i () }
    := ka_aa = WithMatra { onset = { lead = ka_deva (); more = [] }; sign = matra_aa () }
    := ki_first = ?= syllable_visual_order ki ?| | h :: _ => quad_seg_count h | [] => 0u32
    := kaaa_first = ?= syllable_visual_order ka_aa ?| | h :: _ => quad_seg_count h | [] => 0u32
    (ki_first = quad_seg_count (deva_glyph (matra_i ())), kaaa_first = quad_seg_count (deva_glyph (ka_deva ())))
    |> _assert_eq (true, true)

:~ letter_g (advance : f64) : outline quadratic =
    := cx = advance / 2.0f64
    lower_to_quads (OCubic [
        ellipse_contour cx 300.0f64 165.0f64 190.0f64 !+;
        ellipse_contour cx 300.0f64 95.0f64 115.0f64 !-;
        rect_contour (cx + 75.0f64) (-40.0f64) (cx + 165.0f64) 320.0f64;
        arch_down_contour (cx + 25.0f64) (-40.0f64) 140.0f64 100.0f64 50.0f64 50.0f64
    ])

