      rect_contour 240.0f64 330.0f64 400.0f64 420.0f64 ]

:~ jamo_u () : list contour_c =
    [ rect_contour 40.0f64 580.0f64 660.0f64 660.0f64;
      rect_contour 310.0f64 380.0f64 390.0f64 580.0f64 ]

:~ jamo_jieut () : list contour_c =
    [ rect_contour 90.0f64 620.0f64 600.0f64 700.0f64;
      poly4_contour 310.0f64 620.0f64 390.0f64 620.0f64 160.0f64 0.0f64 80.0f64 0.0f64;
      poly4_contour 310.0f64 620.0f64 390.0f64 620.0f64 620.0f64 0.0f64 540.0f64 0.0f64 ]

:~ jamo_kieuk () : list contour_c =
    [ rect_contour 80.0f64 620.0f64 620.0f64 700.0f64;
      rect_contour 540.0f64 0.0f64 620.0f64 700.0f64;
      rect_contour 80.0f64 330.0f64 620.0f64 410.0f64 ]

