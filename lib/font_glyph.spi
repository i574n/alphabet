///> rust
:# arabic_joining_forms_are_typed =
    := b = beh_ar ()
    := a = alef_ar ()
    (quad_seg_count (ar_medial b) > quad_seg_count (ar_isolated b), quad_seg_count (ar_final b) > quad_seg_count (ar_isolated b), quad_seg_count (ar_isolated a) > 0u32, quad_seg_count (ar_final a) > quad_seg_count (ar_isolated a))
    |> _assert_eq (true, true, true, true)

:| cons_c = ConsC

:| indvow_c = IndVowC

:| matra_c = MatraC

:| matra_pos = MPre | MPost | MAbove | MBelow

:| deva c =
    | DevaCons :: outline quadratic -> deva cons_c
    | DevaVow :: outline quadratic -> deva indvow_c
    | DevaMatra :: { glyph : outline quadratic; pos : matra_pos } -> deva matra_c

:= deva_glyph \* c. (d : deva c) : outline quadratic =
    ?= d ?|
    | DevaCons o => o
    | DevaVow o => o
    | DevaMatra m => m::glyph

:= deva_base (d : deva cons_c) : outline quadratic =
    ?= d ?|
    | DevaCons o => o

:= matra_position (m : deva matra_c) : matra_pos =
    ?= m ?|
    | DevaMatra r => r::pos

:~ ka_deva () : deva cons_c =
    DevaCons (lower_to_quads (OCubic [
        rect_contour 30.0f64 600.0f64 530.0f64 655.0f64;
        rect_contour 475.0f64 0.0f64 530.0f64 655.0f64;
        rect_contour 175.0f64 300.0f64 475.0f64 355.0f64;
        rect_contour 175.0f64 355.0f64 230.0f64 600.0f64;
        arch_down_contour 150.0f64 120.0f64 130.0f64 110.0f64 80.0f64 55.0f64
    ]))

:~ ma_deva () : deva cons_c =
    DevaCons (lower_to_quads (OCubic [
