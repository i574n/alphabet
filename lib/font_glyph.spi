///> rust
:# period_is_a_filled_dot_of_four_quads =
    quad_seg_count (letter_period 250.0f64) |> _assert_eq 4u32

///> rust
:# hyphen_is_a_bar_of_three_quads =
    quad_seg_count (letter_hyphen 320.0f64) |> _assert_eq 3u32

///> rust
:# colon_is_two_dots_of_eight_quads =
    quad_seg_count (letter_colon 300.0f64) |> _assert_eq 8u32

///> rust
:# space_is_empty_zero_quads =
    quad_seg_count (letter_space 250.0f64) |> _assert_eq 0u32

///> rust
:# exclaim_is_bar_and_dot_seven_quads =
    quad_seg_count (letter_exclaim 250.0f64) |> _assert_eq 7u32

///> rust
:# zero_is_two_ellipses_eight_quads =
    quad_seg_count (letter_zero 565.0f64) |> _assert_eq 8u32

///> rust
:# hash_is_four_bars_twelve_quads =
    quad_seg_count (letter_hash 560.0f64) |> _assert_eq 12u32

