///- --package .
:# font_glyph static =
    :< testing
:< font_outline

:~ pt (x : f64) (y : f64) : point = { x = x; y = y }

:~ ellipse_contour (cx : f64) (cy : f64) (rx : f64) (ry : f64) (ccw : bool) : contour_c =
    := k = 0.5522847498307936f64
    := s = ? ccw ?> 1.0f64 |: -1.0f64
    { start = pt (cx + rx) cy;
        segs = [
        CCubic (pt (cx + rx) (cy + s * ry * k), pt (cx + rx * k) (cy + s * ry), pt cx (cy + s * ry));
        CCubic (pt (cx - rx * k) (cy + s * ry), pt (cx - rx) (cy + s * ry * k), pt (cx - rx) cy);
        CCubic (pt (cx - rx) (cy - s * ry * k), pt (cx - rx * k) (cy - s * ry), pt cx (cy - s * ry));
        CCubic (pt (cx + rx * k) (cy - s * ry), pt (cx + rx) (cy - s * ry * k), pt (cx + rx) cy)
      ] }

:~ rect_contour (x0 : f64) (y0 : f64) (x1 : f64) (y1 : f64) : contour_c =
    { start = pt x0 y0;
        segs = [ CLine (pt x1 y0); CLine (pt x1 y1); CLine (pt x0 y1) ] }

:~ arch_contour (cx : f64) (ys : f64) (rxo : f64) (ryo : f64) (rxi : f64) (ryi : f64) : contour_c =
    := k = 0.5522847498307936f64
    { start = pt (cx - rxi) ys;
        segs = [
        CCubic (pt (cx - rxi) (ys + ryi * k), pt (cx - rxi * k) (ys + ryi), pt cx (ys + ryi));
        CCubic (pt (cx + rxi * k) (ys + ryi), pt (cx + rxi) (ys + ryi * k), pt (cx + rxi) ys);
        CLine (pt (cx + rxo) ys);
        CCubic (pt (cx + rxo) (ys + ryo * k), pt (cx + rxo * k) (ys + ryo), pt cx (ys + ryo));
        CCubic (pt (cx - rxo * k) (ys + ryo), pt (cx - rxo) (ys + ryo * k), pt (cx - rxo) ys);
        CLine (pt (cx - rxi) ys)
      ] }

:~ arch_down_contour (cx : f64) (ys : f64) (rxo : f64) (ryo : f64) (rxi : f64) (ryi : f64) : contour_c =
    := k = 0.5522847498307936f64
    { start = pt (cx - rxo) ys;
        segs = [
        CCubic (pt (cx - rxo) (ys - ryo * k), pt (cx - rxo * k) (ys - ryo), pt cx (ys - ryo));
        CCubic (pt (cx + rxo * k) (ys - ryo), pt (cx + rxo) (ys - ryo * k), pt (cx + rxo) ys);
        CLine (pt (cx + rxi) ys);
        CCubic (pt (cx + rxi) (ys - ryi * k), pt (cx + rxi * k) (ys - ryi), pt cx (ys - ryi));
        CCubic (pt (cx - rxi * k) (ys - ryi), pt (cx - rxi) (ys - ryi * k), pt (cx - rxi) ys);
        CLine (pt (cx - rxo) ys)
      ] }

:~ letter_u (advance : f64) : outline quadratic =
    lower_to_quads (OCubic [
        rect_contour 72.0f64 130.0f64 162.0f64 500.0f64;
        rect_contour 320.0f64 130.0f64 410.0f64 500.0f64;
        arch_down_contour 241.0f64 150.0f64 169.0f64 150.0f64 79.0f64 60.0f64
    ])

:~ letter_n (advance : f64) : outline quadratic =
    lower_to_quads (OCubic [
        rect_contour 72.0f64 0.0f64 162.0f64 370.0f64;
        rect_contour 320.0f64 0.0f64 410.0f64 370.0f64;
        arch_contour 241.0f64 350.0f64 169.0f64 150.0f64 79.0f64 60.0f64
    ])

:~ letter_h (advance : f64) : outline quadratic =
    lower_to_quads (OCubic [
        rect_contour 72.0f64 0.0f64 162.0f64 710.0f64;
        rect_contour 320.0f64 0.0f64 410.0f64 370.0f64;
        arch_contour 241.0f64 350.0f64 169.0f64 150.0f64 79.0f64 60.0f64
    ])

:~ poly4_contour (ax : f64) (ay : f64) (bx : f64) (by : f64) (cx : f64) (cy : f64) (dx : f64) (dy : f64) : contour_c =
    { start = pt ax ay; segs = [ CLine (pt bx by); CLine (pt cx cy); CLine (pt dx dy) ] }

:~ tf_point (sx : f64) (sy : f64) (dx : f64) (dy : f64) (p : point) : point =
    { x = p::x * sx + dx; y = p::y * sy + dy }

:= tf_seg (sx : f64) (sy : f64) (dx : f64) (dy : f64) (s : cubic_seg) : cubic_seg =
    ?= s ?|
    | CLine e => CLine (tf_point sx sy dx dy e)
    | CQuad (c, e) => CQuad (tf_point sx sy dx dy c, tf_point sx sy dx dy e)
    | CCubic (c1, c2, e) => CCubic (tf_point sx sy dx dy c1, tf_point sx sy dx dy c2, tf_point sx sy dx dy e)

:~ ^ tf_segs (sx : f64) (sy : f64) (dx : f64) (dy : f64) (segs : list cubic_seg) : list cubic_seg =
    ?= segs ?|
    | s :: rest => tf_seg sx sy dx dy s :: tf_segs sx sy dx dy rest
    | [] => []

:~ transform_contour (sx : f64) (sy : f64) (dx : f64) (dy : f64) (c : contour_c) : contour_c =
    { start = tf_point sx sy dx dy c::start; segs = tf_segs sx sy dx dy c::segs }

:= scale_seg_q (sy : f64) (s : quad_seg) : quad_seg =
    ?= s ?|
    | QLine e => QLine (tf_point 1.0f64 sy 0.0f64 0.0f64 e)
    | QQuad (c, e) => QQuad (tf_point 1.0f64 sy 0.0f64 0.0f64 c, tf_point 1.0f64 sy 0.0f64 0.0f64 e)

:~ ^ scale_segs_q (sy : f64) (segs : list quad_seg) : list quad_seg =
    ?= segs ?|
    | s :: rest => scale_seg_q sy s :: scale_segs_q sy rest
    | [] => []

:~ scale_contour_q (sy : f64) (c : contour_q) : contour_q =
    { start = tf_point 1.0f64 sy 0.0f64 0.0f64 c::start; segs = scale_segs_q sy c::segs }

:~ ^ scale_contours_q (sy : f64) (cs : list contour_q) : list contour_q =
    ?= cs ?|
    | c :: rest => scale_contour_q sy c :: scale_contours_q sy rest
    | [] => []

:= scale_outline_y (sy : f64) (o : outline quadratic) : outline quadratic =
    ?= o ?|
    | OQuad cs => OQuad (scale_contours_q sy cs)

:~ ^ cc_append (a : list contour_c) (b : list contour_c) : list contour_c =
    ?= a ?|
    | h :: t => h :: cc_append t b
    | [] => b

:~ ^ tf_contours (sx : f64) (sy : f64) (dx : f64) (dy : f64) (cs : list contour_c) : list contour_c =
    ?= cs ?|
    | c :: rest => transform_contour sx sy dx dy c :: tf_contours sx sy dx dy rest
    | [] => []

:~ compose_vertical (initial : list contour_c) (medial : list contour_c) : outline quadratic =
    lower_to_quads (OCubic (cc_append (tf_contours 0.5f64 0.68f64 60.0f64 110.0f64 initial) (tf_contours 0.55f64 0.9f64 420.0f64 40.0f64 medial)))

:~ jamo_ieung () : list contour_c =
    [ ellipse_contour 250.0f64 250.0f64 180.0f64 180.0f64 !+;
      ellipse_contour 250.0f64 250.0f64 105.0f64 105.0f64 !- ]

:~ jamo_i () : list contour_c =
    [ rect_contour 350.0f64 0.0f64 440.0f64 700.0f64 ]

:~ compose_horizontal (initial : list contour_c) (medial : list contour_c) : outline quadratic =
    lower_to_quads (OCubic (cc_append (tf_contours 0.6f64 0.46f64 180.0f64 380.0f64 initial) (tf_contours 0.92f64 0.46f64 30.0f64 20.0f64 medial)))

:~ jamo_giyeok () : list contour_c =
    [ rect_contour 80.0f64 620.0f64 620.0f64 700.0f64;
      rect_contour 540.0f64 0.0f64 620.0f64 700.0f64 ]

:~ jamo_o () : list contour_c =
    [ rect_contour 40.0f64 40.0f64 660.0f64 120.0f64;
      rect_contour 310.0f64 120.0f64 390.0f64 320.0f64 ]

